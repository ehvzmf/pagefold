Table users {
  id            bigint    [pk, increment]
  email         varchar   [not null, unique]
  password_hash varchar   [not null]
  user_name     varchar   [not null]
  profile_pic   varchar
  created_at    timestamp [not null]
  updated_at    timestamp [not null]
  deleted_at    timestamp
}

Table categories {
  id         bigint    [pk, increment]
  name       varchar   [not null, unique]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table books {
  id              bigint    [pk, increment]
  category_id     bigint    [ref: > categories.id]
  title           varchar   [not null]
  author          varchar   [not null]
  publisher       varchar
  published_year  integer
  isbn            varchar   [unique]
  description     text
  cover_image_url varchar
  epub_url        varchar   [not null]
  language        varchar   [default: 'ko']
  created_at      timestamp [not null]
  updated_at      timestamp [not null]
  deleted_at      timestamp
}

Table user_books {
  id               bigint       [pk, increment]
  user_id          bigint       [not null, ref: > users.id]
  book_id          bigint       [not null, ref: > books.id]
  last_cfi         text
  progress_percent numeric(5,2)
  last_read_at     timestamp
  finished_at      timestamp
  created_at       timestamp    [not null]
  updated_at       timestamp    [not null]
  deleted_at       timestamp

  indexes {
    (user_id, book_id) [unique]
  }
}

Table highlights {
  id            bigint    [pk, increment]
  user_id       bigint    [not null, ref: > users.id]
  book_id       bigint    [not null, ref: > books.id]
  cfi_range     text      [not null]
  selected_text text      [not null]
  color         varchar   [default: 'yellow']
  is_public     boolean   [not null, default: true]
  created_at    timestamp [not null]
  updated_at    timestamp [not null]
  deleted_at    timestamp

  indexes {
    book_id
  }
}

Table notes {
  id           bigint    [pk, increment]
  highlight_id bigint    [not null, ref: > highlights.id]
  user_id      bigint    [not null, ref: > users.id]
  content      text      [not null]
  created_at   timestamp [not null]
  updated_at   timestamp [not null]
  deleted_at   timestamp

  indexes {
    highlight_id
  }
}